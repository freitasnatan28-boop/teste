{
  "name": "tia-fifi-ofertas",
  "version": "0.1.0",
  "private": true,
  "description": "Painel de automação para afiliados: ofertas, links, mensagens e disparo em grupos de WhatsApp.",
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "precos:atualizar": "tsx scripts/atualizar-precos.ts",
    "postinstall": "prisma generate",
    "whatsapp": "tsx worker/whatsapp.mts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@prisma/client": "^6.19.3",
    "baileys": "^7.0.0-rc14",
    "dotenv": "^18.0.4",
    "next": "^16.3.6",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
