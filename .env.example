# ============================================================
# Copie este arquivo para ".env" e preencha os valores.
#   cp .env.example .env
# NUNCA envie o arquivo .env para o GitHub (ele já está no .gitignore).
# ============================================================

# ---------- Painel ----------
# Endereço público do painel (sem barra no final).
# Local: http://localhost:3000   |   VPS: https://painel.seudominio.com.br
APP_URL=http://localhost:3000

# Senha para entrar no painel. Use uma senha forte!
PANEL_PASSWORD=troque-esta-senha

# Chave secreta para assinar o cookie de login (mínimo 32 caracteres).
# Gere uma com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=gere-uma-chave-aleatoria-com-o-comando-acima

# ---------- Banco de dados ----------
# SQLite: arquivo dentro da pasta prisma/
DATABASE_URL="file:./dados.db"

# ---------- Mercado Livre (API oficial) ----------
# Crie o app em https://developers.mercadolivre.com.br/devcenter
# O "Redirect URI" cadastrado lá deve ser EXATAMENTE:
#   {APP_URL}/api/ml/oauth/callback
# (ou outro endereço HTTPS, se usar o modo "colar código" — veja o README)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:3000/api/ml/oauth/callback
# Deixe "true" só se você ativou PKCE nas configurações do app no ML.
ML_USE_PKCE=false
# Modo demonstração: usa produtos de exemplo, sem chamar a API do ML.
# Útil para conhecer o painel antes de criar o app no ML.
ML_MOCK=false

# ---------- Shopee (Fase 5 — desligado) ----------
# Quando sua conta de afiliado for aprovada, pegue AppId e Secret em
# https://affiliate.shopee.com.br/open_api  e mude SHOPEE_ENABLED para true.
SHOPEE_ENABLED=false
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql

# ---------- IA para escrever as mensagens (opcional) ----------
# Crie a chave em https://console.anthropic.com (é pago por uso: centavos por mensagem).
# Sem chave, o painel usa as frases prontas da personagem.
ANTHROPIC_API_KEY=
