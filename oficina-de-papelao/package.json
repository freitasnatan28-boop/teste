{
  "name": "oficina-de-papelao-qa",
  "private": true,
  "description": "Ferramentas de validação da página de vendas (Playwright e Lighthouse)",
  "scripts": {
    "verificar": "node qa/verificar_site.cjs",
    "lighthouse": "lighthouse http://localhost:8765/ --form-factor=mobile --only-categories=performance,accessibility,best-practices,seo --output=html --output-path=dist/qa/lighthouse.html --chrome-flags=\"--headless=new --no-sandbox\""
  },
  "devDependencies": {
    "lighthouse": "^13.5.0",
    "playwright": "1.56.1"
  }
}
