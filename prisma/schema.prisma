// Banco de dados do painel.
// Hoje usa SQLite (um arquivo, zero configuração). Para migrar para Postgres,
// troque o provider para "postgresql" e o DATABASE_URL no .env.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Um produto/oferta vindo de qualquer marketplace.
model Product {
  id                  String   @id @default(cuid())
  marketplace         String // "mercadolivre" | "shopee"
  externalId          String // ID no marketplace (ex.: MLB123 do catálogo ou MLB-anúncio)
  itemId              String? // anúncio vencedor (buy box) no ML
  title               String
  permalink           String?
  imageUrl            String?
  categoryId          String?
  categoryName        String?
  rootCategoryId      String?
  price               Float
  originalPrice       Float?
  currency            String   @default("BRL")
  rating              Float?
  reviewsCount        Int?
  soldQuantity        Int?
  bestSellerPosition  Int?
  freeShipping        Boolean  @default(false)
  officialStore       Boolean  @default(false)
  officialStoreName   String?
  // Score 0–100 e o detalhamento (JSON) de como foi calculado
  score               Int      @default(0)
  scoreDetails        String?
  // Desconto real (considerando o histórico) e alerta de "preço de" inflado
  realDiscountPct     Float?
  suspiciousDiscount  Boolean  @default(false)
  suspiciousReason    String?
  // Link de afiliado (colado do Gerador de Links do ML, ex.: https://meli.la/xxxx)
  affiliateUrl        String?
  // "manual" (colado por você) ou "auto" (montado com seu código de afiliado)
  affiliateSource     String?
  affiliateUpdatedAt  DateTime?
  hidden              Boolean  @default(false)
  lastCheckedAt       DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  priceHistory PriceSnapshot[]
  tags         Tag[]

  @@unique([marketplace, externalId])
  @@index([score])
}

// Histórico: um registro por consulta de preço.
model PriceSnapshot {
  id            String   @id @default(cuid())
  productId     String
  price         Float
  originalPrice Float?
  capturedAt    DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, capturedAt])
}

// Tags de nicho (natal, casa, moda, maternidade, verão...).
model Tag {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  // JSON: lista de palavras-chave que marcam a tag automaticamente
  keywords    String    @default("[]")
  // JSON: lista de IDs de categoria raiz do ML que marcam a tag automaticamente
  categoryIds String    @default("[]")
  products    Product[]
}

// Tokens OAuth dos marketplaces (ex.: Mercado Livre expira a cada 6h).
model OAuthToken {
  provider     String   @id // "mercadolivre"
  accessToken  String
  refreshToken String?
  expiresAt    DateTime
  userId       String?
  nickname     String?
  updatedAt    DateTime @updatedAt
}

// "state" temporário do fluxo OAuth (proteção contra CSRF).
model OAuthState {
  state        String   @id
  codeVerifier String?
  createdAt    DateTime @default(now())
}

// Cache de categorias do ML (nome e categoria raiz).
model CategoryCache {
  id        String   @id
  name      String
  rootId    String
  rootName  String
  updatedAt DateTime @updatedAt
}

// Configurações editáveis pelo painel (ex.: seu código de afiliado do ML).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ================= WhatsApp (Fase 3) =================

// Um número de WhatsApp conectado por QR code (hoje usamos 1: "principal").
model WhatsAppSession {
  id          String    @id
  status      String    @default("desconectado") // desconectado | aguardando_qr | conectado | pausado
  qr          String?
  phone       String?
  lastError   String?
  pausedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// Grupos em que o número é admin. Você marca quais recebem ofertas.
model WhatsAppGroup {
  jid          String    @id
  sessionId    String
  name         String
  participants Int       @default(0)
  isAdmin      Boolean   @default(false)
  enabled      Boolean   @default(false)
  // JSON: tags de nicho do grupo (vazio = recebe todas as ofertas)
  tags         String    @default("[]")
  lastSentAt   DateTime?
  updatedAt    DateTime  @updatedAt
}

// Mensagem pronta de uma oferta (gerada pela IA ou pelo modelo padrão).
model OfferMessage {
  id        String    @id @default(cuid())
  productId String
  text      String
  // JSON com as variações geradas
  variants  String    @default("[]")
  // aguardando_aprovacao | aprovada | enviada | descartada
  status    String    @default("aprovada")
  origin    String    @default("manual") // manual | piloto
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  jobs      SendJob[]

  @@index([status])
}

// Fila de envio: 1 linha por grupo.
model SendJob {
  id          String       @id @default(cuid())
  messageId   String
  message     OfferMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  productId   String
  groupJid    String
  imageUrl    String?
  text        String
  scheduledAt DateTime     @default(now())
  status      String       @default("pendente") // pendente | enviado | erro | cancelado
  attempts    Int          @default(0)
  error       String?
  sentAt      DateTime?
  createdAt   DateTime     @default(now())

  @@index([status, scheduledAt])
}

// Personagem que "fala" nas mensagens.
model Persona {
  id           String   @id @default("principal")
  name         String
  personality  String
  // JSON: listas de bordões, emojis e palavras proibidas
  catchphrases String   @default("[]")
  emojis       String   @default("[]")
  forbidden    String   @default("[]")
  updatedAt    DateTime @updatedAt
}
